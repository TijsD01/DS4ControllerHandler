<Window x:Class="DS4Handler.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DS4Handler.App.Controls"
        xmlns:l="clr-namespace:DS4Handler.App.Lang"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="24" Margin="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <!-- Entrance: scale up from 0.95 while fading in. Closing stays instant (fast exit). -->
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                         Duration="{x:Static c:Motion.Enter}" EasingFunction="{StaticResource EaseOut}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.95" To="1"
                                         Duration="{x:Static c:Motion.Enter}" EasingFunction="{StaticResource EaseOut}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.95" To="1"
                                         Duration="{x:Static c:Motion.Enter}" EasingFunction="{StaticResource EaseOut}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="{l:Loc Common_Cancel}" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"
                        ToolTip="{l:Loc Dialog_CancelTip}" />
                <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
