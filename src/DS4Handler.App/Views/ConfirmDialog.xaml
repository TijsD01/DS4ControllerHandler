<Window x:Class="DS4Handler.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Language="nl-NL">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24" Margin="1">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Annuleren" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"
                        ToolTip="Sluit dit venster zonder iets te veranderen." />
                <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
