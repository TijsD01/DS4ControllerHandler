<Window x:Class="DS4Handler.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:DS4Handler.App.Views"
        xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DS4 Handler"
        Width="1100" Height="800" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Language="nl-NL"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="28,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                ToolTip="DS4 Handler laat je PlayStation-controller in games werken als Xbox- of DualShock 4-controller en corrigeert vanzelf stickdrift en versleten triggers.">
                    <Image x:Name="Logo" Width="36" Height="36" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
                        <TextBlock Text="DS4 Handler" Style="{StaticResource H2}" FontSize="17" />
                        <TextBlock Text="PlayStation-controller als Xbox-controller" Style="{StaticResource Caption}" />
                    </StackPanel>
                    </StackPanel>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding ShowControllers}"
                                 ToolTip="{x:Static vm:Tips.NavControllers}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7FC;" Margin="0,0,8,0" />
                            <TextBlock Text="Controllers" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding ShowProfiles}"
                                 ToolTip="{x:Static vm:Tips.NavProfiles}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE77B;" Margin="0,0,8,0" />
                            <TextBlock Text="Profielen" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding ShowSettings}"
                                 ToolTip="{x:Static vm:Tips.NavSettings}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE713;" Margin="0,0,8,0" />
                            <TextBlock Text="Instellingen" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" ToolTip="{Binding DriverTip}"
                            Background="{Binding DriverLevel, Converter={StaticResource LevelBrush}, ConverterParameter=bg}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding DriverLevel, Converter={StaticResource LevelBrush}}" />
                            <TextBlock Text="{Binding DriverChip}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding DriverLevel, Converter={StaticResource LevelBrush}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" ToolTip="{Binding HidHideTip}"
                            Background="{Binding HidHideLevel, Converter={StaticResource LevelBrush}, ConverterParameter=bg}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding HidHideLevel, Converter={StaticResource LevelBrush}}" />
                            <TextBlock Text="{Binding HidHideChip}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding HidHideLevel, Converter={StaticResource LevelBrush}}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Click="OnQuitClick" ToolTip="{x:Static vm:Tips.Quit}" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE7E8;" Margin="0,0,6,0" />
                            <TextBlock Text="Afsluiten" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Notices ===== -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Notices}" Margin="28,16,28,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NoticeViewModel}">
                    <Border CornerRadius="12" Padding="16,14" Margin="0,0,0,10"
                            Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=bg}"
                            BorderBrush="{Binding Level, Converter={StaticResource LevelBrush}}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0"
                                       Text="{Binding Icon}" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" ToolTip="{Binding SecondaryTip}"
                                        Margin="0,0,8,0" Visibility="{Binding HasSecondary, Converter={StaticResource BoolVis}}" />
                                <Button Style="{StaticResource AccentButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                                        ToolTip="{Binding PrimaryTip}" Visibility="{Binding HasPrimary, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Pages ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,16,28,28">
            <Grid>
                <!-- Controllers -->
                <Grid Visibility="{Binding ShowControllers, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Controllers}"
                                  Visibility="{Binding HasControllers, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
                                <v:ControllerCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="40,56" HorizontalAlignment="Center" VerticalAlignment="Top"
                            MaxWidth="620" Margin="0,40,0,0" ToolTip="{x:Static vm:Tips.EmptyState}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="42" HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentHoverBrush}" />
                            </Border>
                            <TextBlock Text="Nog geen controller gevonden" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,22,0,8" />
                            <TextBlock Text="Sluit een DualShock 4 of DualSense aan via USB of Bluetooth" Style="{StaticResource Dim}" FontSize="15"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <StackPanel Margin="0,26,0,0" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,6">
                                    <Run Text="&#x2460;" Foreground="{StaticResource AccentHoverBrush}" /> <Run Text="USB: steek de kabel in, de controller verschijnt hier vanzelf." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,6">
                                    <Run Text="&#x2461;" Foreground="{StaticResource AccentHoverBrush}" /> <Run Text="Bluetooth: houd PS + Share (of Create) ingedrukt tot het lampje knippert" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Dim}" Margin="22,0,0,0">
                                    <Run Text="en koppel hem in Windows bij Instellingen › Bluetooth." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Profiles -->
                <v:ProfilesPage DataContext="{Binding ProfilesPage}"
                                Visibility="{Binding DataContext.ShowProfiles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />

                <!-- Settings -->
                <v:SettingsPage DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
