<UserControl x:Class="DS4Handler.App.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}">
    <StackPanel>

        <!-- Intro + import -->
        <DockPanel Margin="0,0,0,24" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0">
                <Button Content="Profielmap openen" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"
                        ToolTip="{x:Static vm:Tips.OpenProfileFolder}" />
                <Button Style="{StaticResource AccentButton}" Content="Importeren…" Command="{Binding ImportCommand}"
                        ToolTip="{x:Static vm:Tips.ProfileImport}" />
            </StackPanel>
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" ToolTip="{x:Static vm:Tips.ProfilesIntro}" Background="Transparent">
                <TextBlock Text="Profielen" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                           Text="Elke controller krijgt een eigen profiel, herkend aan zijn MAC-adres. Neem het profiel van een vriend mee met Importeren." />
            </StackPanel>
        </DockPanel>

        <!-- Profiel kiezen per aangesloten controller -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24" Visibility="{Binding HasConnected, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="AANGESLOTEN NU" Style="{StaticResource SectionLabel}" Cursor="Help"
                               ToolTip="{x:Static vm:Tips.ProfileChoose}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Connected}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinkRowViewModel}">
                            <Border Style="{StaticResource SettingRow}" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" MinWidth="120" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,20,0" ToolTip="{x:Static vm:Tips.ProfileName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MacText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                               ToolTip="{x:Static vm:Tips.ProfileMac}" Cursor="Help" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,20,0"
                                               Foreground="{Binding StatusLevel, Converter={StaticResource LevelBrush}, ConverterParameter=text}"
                                               ToolTip="{x:Static vm:Tips.ProfileOnCard}" />
                                    <ComboBox Grid.Column="3" Style="{StaticResource Combo}" VerticalAlignment="Center"
                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                                              DisplayMemberPath="Label" ToolTip="{x:Static vm:Tips.ProfileChoose}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Alle profielen -->
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding Profiles.Count, Mode=OneWay}" />
                        <TextBlock Text="ALLE PROFIELEN" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}" Padding="20,14"
                        Visibility="{Binding HasProfiles, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <TextBlock Text="Nog geen profielen. Sluit een controller aan of importeer een profiel." Style="{StaticResource Dim}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileRowViewModel}">
                            <Border Style="{StaticResource SettingRow}" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" MinWidth="150" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Name (editable) -->
                                    <Grid Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBox x:Name="NameBox" Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{x:Static vm:Tips.ProfileName}" MaxLength="60" FontWeight="SemiBold" AutomationProperties.Name="Naam van het profiel"
                                                 LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" Loaded="OnNameLoaded" />
                                        <TextBlock Text="{Binding NamePlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Name, Converter={StaticResource TextVis}, ConverterParameter=invert}" />
                                    </Grid>

                                    <!-- MAC + model -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding MacText}" Style="{StaticResource Mono}"
                                                   ToolTip="{Binding MacTip}" Cursor="Help" />
                                        <TextBlock Text="{Binding ModelText}" Style="{StaticResource Caption}"
                                                   ToolTip="{x:Static vm:Tips.ProfileModel}" Cursor="Help" />
                                    </StackPanel>

                                    <!-- Status, what was learned, used by -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusTip}" Background="Transparent" HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource Dot}" Margin="0,0,8,0"
                                                       Fill="{Binding StatusLevel, Converter={StaticResource LevelBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusWord}" FontWeight="Normal" TextWrapping="Wrap"
                                                       Foreground="{Binding StatusLevel, Converter={StaticResource LevelBrush}, ConverterParameter=text}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,2,0,0"
                                                   ToolTip="{x:Static vm:Tips.ProfileSummary}" />
                                        <TextBlock Text="{Binding UsedByText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource LinkBrush}" ToolTip="{x:Static vm:Tips.ProfileUsedBy}"
                                                   Visibility="{Binding UsedByText, Converter={StaticResource TextVis}}" />
                                    </StackPanel>

                                    <!-- Actions -->
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="-8,8,0,0">
                                        <Button Style="{StaticResource LinkButton}" Content="Hernoemen" Command="{Binding RenameCommand}" ToolTip="{x:Static vm:Tips.ProfileRename}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Kopiëren naar…" Click="OnCopyClick"
                                                IsEnabled="{Binding CanCopy}" ToolTip="{Binding CopyTip}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Exporteren…" Command="{Binding ExportCommand}" ToolTip="{x:Static vm:Tips.ProfileExport}" />
                                        <Button Style="{StaticResource DangerLinkButton}" Content="Verwijderen"
                                                Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteTip}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
