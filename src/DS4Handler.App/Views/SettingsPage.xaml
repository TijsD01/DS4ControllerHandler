<UserControl x:Class="DS4Handler.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
             xmlns:c="clr-namespace:DS4Handler.App.Controls"
             xmlns:l="clr-namespace:DS4Handler.App.Lang"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <!-- Two columns from 900 px of page width, otherwise the two stacks sit under each other. -->
        <Style x:Key="ColumnStack" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style x:Key="LeftColumn" TargetType="StackPanel" BasedOn="{StaticResource ColumnStack}">
            <Setter Property="Grid.Row" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthToColumns}, ConverterParameter=900}" Value="2">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightColumn" TargetType="StackPanel" BasedOn="{StaticResource ColumnStack}">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Margin" Value="0,20,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource WidthToColumns}, ConverterParameter=900}" Value="2">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Margin" Value="10,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{l:Loc Settings_Title}" Style="{StaticResource H1}" Margin="0,0,0,20" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left: Opstarten + Taal + Updates -->
            <StackPanel Style="{StaticResource LeftColumn}">
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="{l:Loc Settings_Startup}" Style="{StaticResource SectionLabel}" />
                </Border>
                <Border Style="{StaticResource SettingRow}" ToolTip="{x:Static vm:Tips.StartWithWindows}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_StartWithWindows}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{l:Loc Settings_StartWithWindowsText}" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"
                                  AutomationProperties.Name="{l:Loc Settings_StartWithWindows}" ToolTip="{x:Static vm:Tips.StartWithWindows}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" ToolTip="{x:Static vm:Tips.StartMinimized}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_StartMinimized}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{l:Loc Settings_StartMinimizedText}" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}"
                                  AutomationProperties.Name="{l:Loc Settings_StartMinimized}" ToolTip="{x:Static vm:Tips.StartMinimized}" />
                    </Grid>
                </Border>
                    </StackPanel>
                </Border>

                <!-- Taal: used after a restart (all text is read once at startup). -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource SectionLabel}" />
                        </Border>
                        <Border Style="{StaticResource SettingRow}" ToolTip="{l:Loc Settings_LanguageTip}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc Settings_AppLanguage}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:Loc Settings_LanguageText}" Style="{StaticResource Dim}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource Combo}" MinWidth="160" VerticalAlignment="Center"
                                          ItemsSource="{Binding Languages}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding Language}"
                                          AutomationProperties.Name="{l:Loc Settings_AppLanguage}" ToolTip="{l:Loc Settings_LanguageTip}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Settings_LanguageRestartNote}" Style="{StaticResource Dim}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="{l:Loc Settings_RestartNow}" Command="{Binding RestartCommand}"
                                        ToolTip="{l:Loc Settings_RestartNowTip}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0" DataContext="{Binding Updates}">
                    <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="Updates" Style="{StaticResource SectionLabel}" />
                </Border>
                <Border Style="{StaticResource SettingRow}" ToolTip="{x:Static vm:Tips.CheckForUpdates}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_AutoUpdate}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{l:Loc Settings_AutoUpdateText}" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}"
                                  AutomationProperties.Name="{l:Loc Settings_AutoUpdate}" ToolTip="{x:Static vm:Tips.CheckForUpdates}" />
                    </Grid>
                </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,24,0" VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}" /><LineBreak />
                                    <Run Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="{l:Loc Settings_CheckNow}" Command="{Binding CheckNowCommand}"
                                        ToolTip="{x:Static vm:Tips.CheckNow}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: HidHide + Over -->
            <StackPanel Style="{StaticResource RightColumn}">
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                            ToolTip="{Binding HidHideStatus}" Background="Transparent">
                                    <c:StatusMark Level="{Binding HidHideLevel}"
                                                  AutomationProperties.Name="{Binding HidHideLevel, Converter={StaticResource LevelWord}}" />
                                </StackPanel>
                                <TextBlock Text="{l:Loc Settings_HidHideSection}" Style="{StaticResource SectionLabel}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <TextBlock Text="{Binding HidHideStatus}" Style="{StaticResource Dim}" />
                        </Border>
                <Border Style="{StaticResource SettingRow}" ToolTip="{x:Static vm:Tips.HidHideEnabled}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_UseHidHide}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{l:Loc Settings_UseHidHideText}" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HidHideEnabled}"
                                  AutomationProperties.Name="{l:Loc Settings_UseHidHide}" ToolTip="{x:Static vm:Tips.HidHideEnabled}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" ToolTip="{x:Static vm:Tips.UnhideOnExit}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_UnhideOnExit}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{l:Loc Settings_UnhideOnExitText}" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding UnhideOnExit}"
                                  AutomationProperties.Name="{l:Loc Settings_UnhideOnExit}" ToolTip="{x:Static vm:Tips.UnhideOnExit}" />
                    </Grid>
                </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <WrapPanel>
                                <Button Content="{l:Loc Common_Recheck}" Command="{Binding RecheckHidHideCommand}" Margin="0,0,8,0"
                                        ToolTip="{x:Static vm:Tips.RecheckHidHide}" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:Loc Common_DownloadHidHide}" Command="{Binding DownloadHidHideCommand}"
                                        ToolTip="{x:Static vm:Tips.DownloadHidHide}" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0">
                    <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="{l:Loc Settings_About}" Style="{StaticResource SectionLabel}" />
                </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,14"
                                           Text="{l:Loc Settings_AboutText}" />
                                <WrapPanel>
                                    <Button Content="{l:Loc Common_OpenProfileFolder}" Command="{Binding OpenProfilesCommand}" Margin="0,0,8,8"
                                            ToolTip="{x:Static vm:Tips.OpenProfiles}" />
                                    <Button Content="{l:Loc Common_OpenLog}" Command="{Binding OpenLogCommand}" Margin="0,0,8,8"
                                            ToolTip="{x:Static vm:Tips.OpenLog}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Loc Common_DownloadViGEm}" Command="{Binding DownloadViGEmCommand}" Margin="0,0,0,8"
                                            ToolTip="{x:Static vm:Tips.DownloadViGEm}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Afsluiten -->
        <Button Style="{StaticResource DangerButton}" Content="{l:Loc Common_Quit}" Command="{Binding QuitCommand}"
                HorizontalAlignment="Right" Margin="0,24,0,0" ToolTip="{x:Static vm:Tips.Quit}" />
    </StackPanel>
</UserControl>
