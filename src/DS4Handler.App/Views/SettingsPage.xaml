<UserControl x:Class="DS4Handler.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <!-- Setting row: title + explanation on the left, switch on the right. -->
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <!-- Opstarten -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="OPSTARTEN" Style="{StaticResource SectionTitle}" />
                <Grid Style="{StaticResource Row}" ToolTip="{x:Static vm:Tips.StartWithWindows}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Start met Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="De app start vanzelf als je inlogt, zodat je controller direct werkt." Style="{StaticResource Dim}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"
                              VerticalAlignment="Center" ToolTip="{x:Static vm:Tips.StartWithWindows}" />
                </Grid>
                <Grid Style="{StaticResource Row}" Margin="0" ToolTip="{x:Static vm:Tips.StartMinimized}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Geminimaliseerd starten" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Start zonder venster, alleen als icoon in het systeemvak naast de klok." Style="{StaticResource Dim}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}"
                              VerticalAlignment="Center" ToolTip="{x:Static vm:Tips.StartMinimized}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- HidHide -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="VERBERGEN VOOR GAMES (HIDHIDE)" Style="{StaticResource SectionTitle}" />
                <Border Background="{Binding HidHideLevel, Converter={StaticResource LevelBrush}, ConverterParameter=bg}"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                   Text="{Binding HidHideLevel, Converter={StaticResource LevelIcon}}"
                                   Foreground="{Binding HidHideLevel, Converter={StaticResource LevelBrush}}" />
                        <TextBlock Grid.Column="1" Text="{Binding HidHideStatus}" Style="{StaticResource Body}" />
                    </Grid>
                </Border>
                <Grid Style="{StaticResource Row}" ToolTip="{x:Static vm:Tips.HidHideEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="HidHide gebruiken" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Verberg je echte controllers voor games, zodat ze alleen de Xbox-controller zien. Dit voorkomt dubbele input. Per controller zet je dit aan of uit met 'Verberg voor games'." Style="{StaticResource Dim}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HidHideEnabled}"
                              VerticalAlignment="Center" ToolTip="{x:Static vm:Tips.HidHideEnabled}" />
                </Grid>
                <Grid Style="{StaticResource Row}" ToolTip="{x:Static vm:Tips.UnhideOnExit}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Weer zichtbaar maken bij afsluiten" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Als je DS4 Handler sluit, zien games en andere programma's je PlayStation-controller weer gewoon." Style="{StaticResource Dim}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding UnhideOnExit}"
                              VerticalAlignment="Center" ToolTip="{x:Static vm:Tips.UnhideOnExit}" />
                </Grid>
                <WrapPanel>
                    <Button Content="Opnieuw controleren" Command="{Binding RecheckHidHideCommand}" Margin="0,0,10,0"
                            ToolTip="{x:Static vm:Tips.RecheckHidHide}" />
                    <Button Content="HidHide downloaden" Command="{Binding DownloadHidHideCommand}"
                            ToolTip="{x:Static vm:Tips.DownloadHidHide}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Over -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="OVER DS4 HANDLER" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,14">
                    <Run Text="{Binding Version, Mode=OneWay}" /><LineBreak />
                    <Run Text="Je PlayStation-controller werkt in games als een Xbox 360-controller. De app leert vanzelf de drift van je sticks en de slijtage van je triggers en corrigeert die." />
                </TextBlock>
                <WrapPanel>
                    <Button Content="Profielmap openen" Command="{Binding OpenProfilesCommand}" Margin="0,0,10,10"
                            ToolTip="{x:Static vm:Tips.OpenProfiles}" />
                    <Button Content="Logbestand openen" Command="{Binding OpenLogCommand}" Margin="0,0,10,10"
                            ToolTip="{x:Static vm:Tips.OpenLog}" />
                    <Button Content="ViGEmBus downloaden" Command="{Binding DownloadViGEmCommand}" Margin="0,0,10,10"
                            ToolTip="{x:Static vm:Tips.DownloadViGEm}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
