<UserControl x:Class="DS4Handler.App.Views.TuningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TuningViewModel}">

    <UserControl.Resources>
        <!-- One slider row: label | slider | value in mono. -->
        <DataTemplate x:Key="TuneSliderRow" DataType="{x:Type vm:TuningSlider}">
            <Grid Margin="0,0,0,8" ToolTip="{Binding Tip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Style="{StaticResource Slider}" Margin="8,0,12,0" VerticalAlignment="Center"
                        Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Mono}" FontSize="13"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Column title with its own "Standaard" link. -->
        <DataTemplate x:Key="ColumnHead">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Standaard"
                        Command="{Binding ResetCommand}" ToolTip="{x:Static vm:Tips.TuneResetSection}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- One stick. -->
        <DataTemplate x:Key="TuneStick" DataType="{x:Type vm:StickTuningSection}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ColumnHead}" />
                <Grid Margin="0,0,0,10" ToolTip="{x:Static vm:Tips.TuneShape}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Vorm" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Rond" IsChecked="{Binding ShapeRadial}"
                                         GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeRadial}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Vierkant" IsChecked="{Binding ShapeSquare}"
                                         GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeSquare}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Kruis" IsChecked="{Binding ShapeAxial}"
                                         GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeAxial}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Sliders}" ItemTemplate="{StaticResource TuneSliderRow}" Focusable="False" />
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SquareOutput}" Margin="0,0,20,6"
                              ToolTip="{x:Static vm:Tips.TuneSquareOutput}">
                        <TextBlock Text="Vierkante uitvoer" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InvertX}" Margin="0,0,20,6"
                              ToolTip="{x:Static vm:Tips.TuneInvertX}">
                        <TextBlock Text="X omdraaien" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InvertY}" Margin="0,0,0,6"
                              ToolTip="{x:Static vm:Tips.TuneInvertY}">
                        <TextBlock Text="Y omdraaien" />
                    </CheckBox>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One trigger. -->
        <DataTemplate x:Key="TuneTrigger" DataType="{x:Type vm:TriggerTuningSection}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ColumnHead}" />
                <ItemsControl ItemsSource="{Binding Sliders}" ItemTemplate="{StaticResource TuneSliderRow}" Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: what happens with changes, and reset everything. -->
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Alles op standaard"
                    Command="{Binding ResetAllCommand}" ToolTip="{x:Static vm:Tips.TuneResetAll}" />
            <TextBlock Text="Wijzigingen worden meteen opgeslagen in het profiel van deze controller." Style="{StaticResource Dim}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       ToolTip="{x:Static vm:Tips.TuneSection}" Cursor="Help" />
        </DockPanel>
        <TextBlock Text="{Binding SaveNote}" Style="{StaticResource Body}" Foreground="{StaticResource WarningBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding SaveNote, Converter={StaticResource TextVis}}" />

        <!-- Sticks -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="STICKS" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" ToolTip="{x:Static vm:Tips.TuneSection}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding Left}" ContentTemplate="{StaticResource TuneStick}" Margin="0,0,20,0" />
                    <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" />
                    <ContentPresenter Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource TuneStick}" Margin="20,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Triggers -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="TRIGGERS" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding L2}" ContentTemplate="{StaticResource TuneTrigger}" Margin="0,0,20,0" />
                    <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" />
                    <ContentPresenter Grid.Column="2" Content="{Binding R2}" ContentTemplate="{StaticResource TuneTrigger}" Margin="20,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Snelheid -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Standaard"
                            Command="{Binding ResetSpeedCommand}" ToolTip="{x:Static vm:Tips.TuneResetSection}" />
                    <TextBlock Text="SNELHEID" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,32,8" Width="280">
                        <TextBlock Text="Meten via Bluetooth (DualShock 4)" Style="{StaticResource Body}" Margin="0,0,0,6"
                                   ToolTip="{x:Static vm:Tips.TunePoll}" Cursor="Help" />
                        <ComboBox Style="{StaticResource Combo}" ItemsSource="{x:Static vm:TuningViewModel.PollChoices}"
                                  SelectedItem="{Binding SelectedPoll, Mode=TwoWay}" DisplayMemberPath="Label"
                                  IsEnabled="{Binding SupportsPoll}" ToolTip="{x:Static vm:Tips.TunePoll}" />
                        <TextBlock Text="{Binding PollNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   ToolTip="{x:Static vm:Tips.TunePollUnavailable}"
                                   Visibility="{Binding PollNote, Converter={StaticResource TextVis}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Width="280">
                        <TextBlock Text="Naar de game sturen" Style="{StaticResource Body}" Margin="0,0,0,6"
                                   ToolTip="{x:Static vm:Tips.TuneOutputRate}" Cursor="Help" />
                        <ComboBox Style="{StaticResource Combo}" ItemsSource="{x:Static vm:TuningViewModel.OutputChoices}"
                                  SelectedItem="{Binding SelectedOutputRate, Mode=TwoWay}" DisplayMemberPath="Label"
                                  ToolTip="{x:Static vm:Tips.TuneOutputRate}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
