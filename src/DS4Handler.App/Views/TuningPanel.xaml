<UserControl x:Class="DS4Handler.App.Views.TuningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:DS4Handler.App.Controls"
             xmlns:vm="clr-namespace:DS4Handler.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TuningViewModel}">

    <UserControl.Resources>
        <!-- One slider row: label | slider | value in mono. -->
        <DataTemplate x:Key="TuneSliderRow" DataType="{x:Type vm:TuningSlider}">
            <Grid MinHeight="36" ToolTip="{Binding Tip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Style="{StaticResource Slider}" VerticalAlignment="Center"
                        Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Tip}" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource MonoValue}" />
            </Grid>
        </DataTemplate>

        <!-- Card title with its own "Standaard" link (for a Stick- or TriggerTuningSection). -->
        <DataTemplate x:Key="SectionHead" DataType="{x:Type vm:TuningSection}">
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Standaard"
                        Command="{Binding ResetCommand}" ToolTip="{x:Static vm:Tips.TuneResetSection}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- One stick: curve preview | shape + sliders; switches below. -->
        <DataTemplate x:Key="TuneStick" DataType="{x:Type vm:StickTuningSection}">
            <Border Style="{StaticResource Card}" Margin="0,0,20,20">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{x:Static vm:Tips.CurveStick}" Background="Transparent" VerticalAlignment="Top">
                            <c:CurvePreview Width="150" Height="150" HorizontalAlignment="Left"
                                            InnerDeadzone="{Binding Inner.Value}" OuterDeadzone="{Binding Outer.Value}"
                                            AntiDeadzone="{Binding Anti.Value}" Curve="{Binding Curve.Value}" Sensitivity="{Binding Sensitivity.Value}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Reactiecurve {0}'}" />
                            <TextBlock Text="{Binding CurveCaption}" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid MinHeight="36" ToolTip="{x:Static vm:Tips.TuneShape}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vorm" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Rond" IsChecked="{Binding ShapeRadial}"
                                                     GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeRadial}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Vierkant" IsChecked="{Binding ShapeSquare}"
                                                     GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeSquare}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Kruis" IsChecked="{Binding ShapeAxial}"
                                                     GroupName="{Binding Group}" ToolTip="{x:Static vm:Tips.TuneShapeAxial}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Sliders}" ItemTemplate="{StaticResource TuneSliderRow}" Focusable="False" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                        <WrapPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SquareOutput}" Margin="0,0,20,6"
                                      ToolTip="{x:Static vm:Tips.TuneSquareOutput}" Content="Vierkante uitvoer" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InvertX}" Margin="0,0,20,6"
                                      ToolTip="{x:Static vm:Tips.TuneInvertX}" Content="X omdraaien" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InvertY}" Margin="0,0,0,6"
                                      ToolTip="{x:Static vm:Tips.TuneInvertY}" Content="Y omdraaien" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One trigger: curve preview | sliders. -->
        <DataTemplate x:Key="TuneTrigger" DataType="{x:Type vm:TriggerTuningSection}">
            <Border Style="{StaticResource Card}" Margin="0,0,20,20">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{x:Static vm:Tips.CurveTrigger}" Background="Transparent" VerticalAlignment="Top">
                            <c:CurvePreview Width="150" Height="150" HorizontalAlignment="Left"
                                            InnerDeadzone="{Binding Inner.Value}" OuterDeadzone="{Binding Outer.Value}"
                                            AntiDeadzone="{Binding Anti.Value}" Curve="{Binding Curve.Value}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Reactiecurve {0}'}" />
                            <TextBlock Text="{Binding CurveCaption}" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Sliders}" ItemTemplate="{StaticResource TuneSliderRow}" Focusable="False" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,20,0,0">
        <!-- Section picker | "saved at once" | reset everything -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SegmentHost}" ToolTip="{x:Static vm:Tips.TunePicker}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Sticks" IsChecked="{Binding ShowSticks}" ToolTip="{x:Static vm:Tips.TuneSticks}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Triggers" IsChecked="{Binding ShowTriggers}" ToolTip="{x:Static vm:Tips.TuneTriggers}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Snelheid" IsChecked="{Binding ShowSpeed}" ToolTip="{x:Static vm:Tips.TuneSpeed}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="1" Text="Wijzigingen worden meteen opgeslagen in het profiel van deze controller." Style="{StaticResource Dim}"
                       VerticalAlignment="Center" Margin="20,0" Cursor="Help" ToolTip="{x:Static vm:Tips.TuneSaved}" />
            <Button Grid.Column="2" Content="Alles op standaard" Command="{Binding ResetAllCommand}" ToolTip="{x:Static vm:Tips.TuneResetAll}"
                    VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding SaveNote}" Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,16"
                   ToolTip="{x:Static vm:Tips.TuneSection}" Visibility="{Binding SaveNote, Converter={StaticResource TextVis}}" />

        <!-- Sticks: two cards side by side when there is room, else stacked. -->
        <UniformGrid Margin="0,0,-20,0" Visibility="{Binding ShowSticks, Converter={StaticResource BoolVis}}"
                     Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}, ConverterParameter=1060}">
            <ContentPresenter Content="{Binding Left}" ContentTemplate="{StaticResource TuneStick}" />
            <ContentPresenter Content="{Binding Right}" ContentTemplate="{StaticResource TuneStick}" />
        </UniformGrid>

        <!-- Triggers -->
        <UniformGrid Margin="0,0,-20,0" Visibility="{Binding ShowTriggers, Converter={StaticResource BoolVis}}"
                     Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}, ConverterParameter=1000}">
            <ContentPresenter Content="{Binding L2}" ContentTemplate="{StaticResource TuneTrigger}" />
            <ContentPresenter Content="{Binding R2}" ContentTemplate="{StaticResource TuneTrigger}" />
        </UniformGrid>

        <!-- Snelheid -->
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowSpeed, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Standaard"
                            Command="{Binding ResetSpeedCommand}" ToolTip="{x:Static vm:Tips.TuneResetSection}" />
                    <TextBlock Text="SNELHEID" Style="{StaticResource SectionLabel}" ToolTip="{x:Static vm:Tips.TuneSpeed}" />
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,40,8" Width="320">
                        <TextBlock Text="Meten via Bluetooth (DualShock 4)" Style="{StaticResource RowTitle}" Margin="0,0,0,8"
                                   ToolTip="{x:Static vm:Tips.TunePoll}" Cursor="Help" />
                        <ComboBox Style="{StaticResource Combo}" ItemsSource="{x:Static vm:TuningViewModel.PollChoices}"
                                  SelectedItem="{Binding SelectedPoll, Mode=TwoWay}" DisplayMemberPath="Label"
                                  IsEnabled="{Binding SupportsPoll}" ToolTip="{x:Static vm:Tips.TunePoll}"
                                  AutomationProperties.Name="Meten via Bluetooth" />
                        <TextBlock Text="{Binding PollNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   ToolTip="{x:Static vm:Tips.TunePollUnavailable}"
                                   Visibility="{Binding PollNote, Converter={StaticResource TextVis}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Width="320">
                        <TextBlock Text="Naar de game sturen" Style="{StaticResource RowTitle}" Margin="0,0,0,8"
                                   ToolTip="{x:Static vm:Tips.TuneOutputRate}" Cursor="Help" />
                        <ComboBox Style="{StaticResource Combo}" ItemsSource="{x:Static vm:TuningViewModel.OutputChoices}"
                                  SelectedItem="{Binding SelectedOutputRate, Mode=TwoWay}" DisplayMemberPath="Label"
                                  ToolTip="{x:Static vm:Tips.TuneOutputRate}" AutomationProperties.Name="Naar de game sturen" />
                        <TextBlock Text="Elke meting is het snelst en voor bijna iedereen goed." Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   ToolTip="{x:Static vm:Tips.TuneOutputRate}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
