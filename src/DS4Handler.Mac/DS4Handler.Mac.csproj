<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DS4Handler</AssemblyName>
    <RootNamespace>DS4Handler.Mac</RootNamespace>
    <Product>DS4 Handler</Product>
    <Description>PlayStation-controller op de Mac: live bekijken en zelflerende kalibratie.</Description>
    <SatelliteResourceLanguages>nl</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The linked engine calls Windows-only APIs behind OperatingSystem checks or try/catch. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- The engine of the Windows app, compiled in as-is: reading, calibration, profiles and settings are the same
       on both platforms. On macOS there is no ViGEmBus, so sessions run without a virtual pad. -->
  <ItemGroup>
    <Compile Include="..\DS4Handler.App\Engine\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\DS4Handler.App\Infrastructure\Log.cs" Link="Infrastructure\Log.cs" />
    <Compile Include="..\DS4Handler.App\Infrastructure\SchedulingBoost.cs" Link="Infrastructure\SchedulingBoost.cs" />
    <Compile Include="..\DS4Handler.App\Services\AppSettings.cs" Link="Services\AppSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\DS4Handler.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\DS4Handler.App\Assets\Logo\app.ico" Link="Assets\Logo\app.ico" />
    <None Include="..\DS4Handler.App\Assets\Fonts\OFL-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="HidSharp" Version="$(HidSharpVersion)" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DS4Handler.Core\DS4Handler.Core.csproj" />
    <ProjectReference Include="..\DS4Handler.HidHide\DS4Handler.HidHide.csproj" />
  </ItemGroup>

</Project>
