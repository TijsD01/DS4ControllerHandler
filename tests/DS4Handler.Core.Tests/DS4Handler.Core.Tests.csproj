<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- AppLinked/: HidHideUninstall.cs uses the Windows registry (guarded by try/catch); fine in tests. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- App-only logic that runs without Windows/WPF, compiled in from the app's source (with small stubs in
       AppLinked/ for Log and OutputMode). If one of these files starts using more of the app, add a stub or drop it here. -->
  <ItemGroup>
    <Compile Include="..\..\src\DS4Handler.App\Services\AppSettings.cs" Link="AppLinked\Source\AppSettings.cs" />
    <Compile Include="..\..\src\DS4Handler.App\Services\HidHideUninstall.cs" Link="AppLinked\Source\HidHideUninstall.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DS4Handler.Core\DS4Handler.Core.csproj" />
    <ProjectReference Include="..\..\src\DS4Handler.HidHide\DS4Handler.HidHide.csproj" />
  </ItemGroup>

</Project>
